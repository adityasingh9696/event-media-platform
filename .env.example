# =============================================================================
# Event & Media Management Platform — Environment Variables
# ✅ 100% FREE STACK — No credit card required anywhere
# =============================================================================

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:4000

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Local Dev: uses Docker (docker-compose up -d)
DATABASE_URL="postgresql://empuser:emppassword@localhost:5432/empdb?schema=public"
# Production: Get FREE from https://neon.tech (no credit card)
# DATABASE_URL="postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/empdb?sslmode=require"

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Local Dev: uses Docker
MONGODB_URI="mongodb://empuser:emppassword@localhost:27017/empdb?authSource=admin"
# Production: Get FREE from https://mongodb.com/atlas (M0 cluster, no credit card)
# MONGODB_URI="mongodb+srv://user:pass@cluster.mongodb.net/empdb?retryWrites=true"

# ── Redis ─────────────────────────────────────────────────────────────────────
# Local Dev: uses Docker
REDIS_URL="redis://:empredis@localhost:6379"
# Production: Get FREE from https://upstash.com (no credit card)
# REDIS_URL="rediss://default:xxx@xxx.upstash.io:6379"

# ── Cloudinary (FREE Media Storage — replaces AWS S3) ─────────────────────────
# Sign up FREE at https://cloudinary.com (no credit card, 25GB free)
# Dashboard → Settings → API Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_UPLOAD_PRESET=emp_unsigned   # Create unsigned preset in Cloudinary dashboard

# ── Hugging Face (FREE AI — replaces AWS Rekognition + Bedrock) ───────────────
# Sign up FREE at https://huggingface.co → Settings → Access Tokens → New Token (read)
HUGGINGFACE_API_KEY=hf_your_token_here

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_this_to_a_long_random_string_in_production
JWT_REFRESH_SECRET=change_this_to_another_long_random_string_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Google OAuth (FREE) ───────────────────────────────────────────────────────
# Get FREE from https://console.cloud.google.com → APIs → Credentials (no credit card)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# ── Next.js Public Variables ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=emp_unsigned

# ── Production URLs (fill after deploying) ────────────────────────────────────
# NEXT_PUBLIC_API_URL=https://your-app.onrender.com
# NEXT_PUBLIC_SOCKET_URL=https://your-app.onrender.com
